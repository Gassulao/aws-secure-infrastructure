[Unit]
Description=Status service (FastAPI)
After=network.target

[Service]
User=ssm-user
WorkingDirectory=/home/ssm-user/aws-secure-infrastructure/app
Environment=APP_VERSION=0.1.0
ExecStart=/home/ssm-user/aws-secure-infrastructure/app/.venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000
Restart=always

[Install]
WantedBy=multi-user.target